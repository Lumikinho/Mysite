---
import AgeTimeCard from "../components/AgeTimeCard.tsx";
import GithubProfilePicture from "../components/GithubProfilePicture.tsx";
import DiscordProfile from "../components/DiscordProfile.tsx";
import TimePill from "../components/TimePill.tsx";
import WeatherPill from "../components/WeatherPill.tsx";
import SpeedInsights from '@vercel/speed-insights/astro'

const discordUserId =
  import.meta.env.PUBLIC_DISCORD_USER_ID ?? import.meta.env.DISCORD_USER_ID ?? "";

const weatherCity = import.meta.env.PUBLIC_WEATHER_CITY ?? "Sumare,BR";
const locationLabel = import.meta.env.PUBLIC_WEATHER_LABEL ?? "Meu local";
---

<header
  class="mx-auto grid w-full max-w-5xl grid-cols-1 items-center gap-10 py-10 text-center md:min-h-[70vh] md:grid-cols-2 md:items-start md:gap-6 md:py-14 md:text-left"
>
  <div class="flex flex-col items-center gap-2 md:items-start md:order-1">
    <p class="text-sm font-semibold tracking-wide text-zinc-400 order-1">Hi There!</p>
    
    <div class="relative order-2 md:hidden mb-4">
      <div class="absolute -inset-8 rounded-full bg-white/5 blur-2xl"></div>
      <div class="relative rounded-full ring-2 ring-white/10 shadow-[0_30px_90px_rgba(0,0,0,0.75)]">
        <GithubProfilePicture username="lumikinho" client:load />
      </div>
    </div>

    <h1 class="text-4xl font-extrabold tracking-tight md:text-5xl order-3">
    Lumiko
    </h1>

    <div class="mt-1 text-lg font-bold text-zinc-100 order-4">
      <AgeTimeCard client:load />
    </div>

    <div class="max-w-xl text-zinc-300 order-5">
      <p class="mt-2 inline-block text-lg leading-snug text-zinc-300/90">
        Atualmente estou estudando Desenvolvimento de Sistemas no Senai,
        utilizando Express.js, Node.js, JavaScript, HTML, CSS e MySQL
      </p>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-center gap-4 md:justify-start order-6">
      <a
        href="/Lucas_Miranda_ribeiro.pdf"
        download="Lucas_Miranda_ribeiro.pdf"
        class="inline-flex items-center gap-1 rounded-full border border-zinc-800 bg-zinc-950/40 px-6 py-2.5 font-semibold text-zinc-100 backdrop-blur-md transition-colors hover:border-zinc-700 text-[14px]"
      >
        Download my CV
      </a>

      <div class="flex items-center gap-3">
        <a
          href="https://www.linkedin.com/in/lucas-miranda-ribeiro-0a00b83a0/"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="LinkedIn"
          class="inline-flex items-center justify-center rounded-full border border-zinc-800 bg-zinc-950/40 p-2.5 text-zinc-100 backdrop-blur-md transition-colors hover:border-zinc-700"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
        </a>
        <a
          href="https://x.com/Rootlumiko"
          target="_blank"
          rel="noopener noreferrer"
          aria-label="Twitter / X"
          class="inline-flex items-center justify-center rounded-full border border-zinc-800 bg-zinc-950/40 p-2.5 text-zinc-100 backdrop-blur-md transition-colors hover:border-zinc-700"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
        </a>
        <a
          href="mailto:lucasmirandar11@gmail.com"
          aria-label="Email"
          class="inline-flex items-center justify-center rounded-full border border-zinc-800 bg-zinc-950/40 p-2.5 text-zinc-100 backdrop-blur-md transition-colors hover:border-zinc-700"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
        </a>
      </div>
    </div>

    <div
      class="mt-8 flex w-full flex-nowrap items-center justify-center gap-3 overflow-x-auto pb-1 [-ms-overflow-style:none] [scrollbar-width:none] [&::-webkit-scrollbar]:hidden md:justify-start md:overflow-visible order-7"
      role="list"
      aria-label="Status"
    >
      <div role="listitem" class="shrink-0">
        <DiscordProfile userId={discordUserId} client:load />
      </div>
      <div role="listitem" class="shrink-0">
        <TimePill label="Hora local" client:load />
      </div>
      <div role="listitem" class="shrink-0">
        <WeatherPill
          city={weatherCity}
          label={locationLabel}
          apiKey={import.meta.env.PUBLIC_OPENWEATHER_KEY}
          client:load
        />
      </div>
    </div>
  </div>

  <div class="hidden md:flex w-full justify-center md:justify-end md:order-2">
    <div class="relative">
      <div class="absolute -inset-8 rounded-full bg-white/5 blur-2xl"></div>
      <div class="relative rounded-full ring-2 ring-white/10 shadow-[0_30px_90px_rgba(0,0,0,0.75)]">
        <GithubProfilePicture username="lumikinho" client:load />
      </div>
    </div>
  </div>
</header>
